<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar with Back Navigation Icon -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0066FF"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/white"
            app:title="Passenger &amp; Ticket Selection"
            app:titleTextColor="@color/white" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Card 1: Passenger Count & Fare Calculation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#0066FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👨‍👩‍👧‍👦 Select Passengers (Max 4 Total)"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#0066FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fares adjust automatically based on passenger age (Child: 25% Off, Infant: 80% Off)"
                            android:textSize="11.5sp"
                            android:textColor="#666666"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="14dp" />

                        <!-- Adult Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Adult (12+ yrs)"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#222222"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Full Fare (100%)"
                                    android:textSize="11sp"
                                    android:textColor="#0066FF"/>
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinusAdult"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:text="-"
                                android:textSize="16sp"
                                android:padding="0dp"
                                app:cornerRadius="20dp"/>

                            <TextView
                                android:id="@+id/tvAdultCount"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textColor="#1A1A1A"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlusAdult"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:padding="0dp"
                                app:cornerRadius="20dp"/>
                        </LinearLayout>

                        <!-- Child Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Child (2 - 11 yrs)"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#222222"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="75% Fare (25% Discount)"
                                    android:textSize="11sp"
                                    android:textColor="#2E7D32"/>
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinusChild"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:text="-"
                                android:textSize="16sp"
                                android:padding="0dp"
                                app:cornerRadius="20dp"/>

                            <TextView
                                android:id="@+id/tvChildCount"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textColor="#1A1A1A"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlusChild"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:padding="0dp"
                                app:cornerRadius="20dp"/>
                        </LinearLayout>

                        <!-- Infant Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Infant (Under 2 yrs)"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#222222"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20% Fare (Lap Seat)"
                                    android:textSize="11sp"
                                    android:textColor="#D81B60"/>
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinusInfant"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:text="-"
                                android:textSize="16sp"
                                android:padding="0dp"
                                app:cornerRadius="20dp"/>

                            <TextView
                                android:id="@+id/tvInfantCount"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textColor="#1A1A1A"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlusInfant"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:padding="0dp"
                                app:cornerRadius="20dp"/>
                        </LinearLayout>

                        <!-- Selected Seats Summary -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"
                            android:layout_marginVertical="10dp" />

                        <TextView
                            android:id="@+id/tvSelectedSeatsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Passengers (1/4): 1 Adult"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0066FF" />

                        <TextView
                            android:id="@+id/tvCalculatedFare"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Amount: ৳ 0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2 Container: Dynamic Passenger Input Cards (Passenger 1, Passenger 2, etc.) -->
                <LinearLayout
                    android:id="@+id/layoutPassengersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Card 3: Flight Class Selection -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✈️ Flight Class Selection"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#0066FF"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Flight Class">
                            <AutoCompleteTextView
                                android:id="@+id/etClass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Proceed Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProceedToPayment"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Proceed to Payment ➔"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    android:backgroundTint="#0066FF" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Persistent AI Support FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSupport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_ai_support"
        app:backgroundTint="#1A1A1A"
        app:tint="@null"
        app:fabCustomSize="56dp"
        android:contentDescription="Support" />

</RelativeLayout>